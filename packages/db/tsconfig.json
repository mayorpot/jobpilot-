{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "noEmit": false,
    "outDir": "./dist",
    "declaration": true
  },
  "include": ["src/**/*", "generated/**/*"]
}